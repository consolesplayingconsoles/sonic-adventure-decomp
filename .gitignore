# Everything game-derived or SDK-derived stays local: setup.sh regenerates it from your own disc.
1ST_READ.BIN
IP.BIN
*.gdi
*.bin
*.raw
*.chd
asm/
objects.txt
text-map/
text-dump/
build/
state/
sdk-source/
*.sigs
report*.txt
.env
disc/
.idea/
__pycache__/

# kick-off scratch (SDK archive, executable copies): never commit
.transfer/

# patch leftovers
*.orig
# case-file backups the retest tool leaves behind
*.json.old
# generated per overlay (tools/overlay/in.sh, the checker)
overlays/*/symbols.txt
overlays/*/state/
# C units of the overlays: written from overlays/src/ and overlays/units.tsv when building (tools/overlay/place_units.py)
overlays/*/src/
# an overlay's load address for the shared tools, written by tools/overlay/in.sh from overlays.tsv
overlays/*/BASE
